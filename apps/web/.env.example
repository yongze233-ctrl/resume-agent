# ============================================================
# Magic Resume – Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in the values. Everything is
# optional for editing: resumes are stored in IndexedDB without an account.
# Polaris needs the agent (apps/agent) and your own model API key.

# ------ Polaris (AI assistant) ------------------------------------------
# Server-only origin of the AI backend (without /api): the bundled agent in
# apps/agent (port 4000 by default) or anything implementing
# docs/reference/ai-backend.md.
# AI_BACKEND_URL=http://localhost:4000

# Optional operator-provided default for a shared test deployment. Server-only;
# browsers receive public model metadata, never this credential. Personal BYOK overrides it.
# DEFAULT_MODEL_API_KEY=
# Optional additional shared models, selectable in the composer.
# Keys are server-only. These use the provider presets in lib/constants/modals.ts.
# SITE_OPENCODE_GO_API_KEY=
# SITE_AGNES_API_KEY=
# DEFAULT_MODEL_BASE_URL=https://opencode.ai/zen/go/v1
# DEFAULT_MODEL_NAME=deepseek-v4.1-flash
# DEFAULT_MODEL_MAX_TOKENS=12000
# Agnes international Token Plan alternative:
# DEFAULT_MODEL_BASE_URL=https://apihub.agnes-ai.com/v1
# DEFAULT_MODEL_NAME=agnes-3.0-flash
# DEFAULT_MODEL_MAX_TOKENS=16384

# ------ App URL -------------------------------------------------------
# Public origin, used for robots.txt and the sitemap. APP_PUBLIC_URL is read
# at request time, so one image can serve several domains without a rebuild.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_PUBLIC_URL=https://resume.example.com

# Enable only together with AGENT_AUTH_REQUIRED on the private agent.
SITE_AUTH_REQUIRED=false
# Public release label, set at build time for frontend error code locations.
# NEXT_PUBLIC_RELEASE_ID=20261104-release

# ------ Help menu -----------------------------------------------------
# Link target for "Help center". The menu item is hidden when unset.
# NEXT_PUBLIC_DOCS_URL=https://docs.example.com
